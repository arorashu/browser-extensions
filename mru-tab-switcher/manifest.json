{
  "manifest_version": 3,
  "name": "MRU Tab Switcher",
  "version": "1.2.0",
  "description": "Switch to the most recently used tab, or open a picker to walk through recent tabs with thumbnails.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "switch-mru": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "MacCtrl+Period"
      },
      "description": "Switch to most recently used tab (instant toggle)"
    },
    "open-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Open recent-tabs picker"
    }
  }
}
